# ---------------------------------------------------------------------------
# Homefix Connect — variables de entorno
#
# Copia este archivo a `.env` en la raíz del repo:
#   cp .env.example .env
#
# `.env` NO se commitea. Nunca pongas credenciales reales aquí.
# Los valores vacíos son válidos: la app arranca y las rutas que necesitan
# credenciales de Vonage fallan con un error explícito al usarlas.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Base de datos (docker-compose local) ---------------------------------
# Debe coincidir con docker-compose.yml
DATABASE_URL=postgresql://homefix:homefix@localhost:5432/homefix?schema=public

# --- Vonage Video (carril A) ----------------------------------------------
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
# Ruta al private.key de la aplicación de Video (NO commitear el archivo)
VONAGE_PRIVATE_KEY_PATH=./private.key

# --- Vonage Messages / SMS (carril B) -------------------------------------
VONAGE_MESSAGES_FROM=
# Números de prueba en formato E.164, ej. +34600000000
MANAGER_PHONE=
TENANT_PHONE=
TECHNICIAN_PHONE=

# --- Webhooks --------------------------------------------------------------
# En local con ngrok: la URL pública que te da ngrok
WEBHOOK_BASE_URL=http://localhost:3000
# Secreto de firma de los webhooks de Vonage Messages
VONAGE_SIGNATURE_SECRET=

# --- Frontend (Vite) -------------------------------------------------------
# En dev el proxy de Vite ya redirige /api al backend; se puede dejar vacío.
VITE_API_BASE_URL=
