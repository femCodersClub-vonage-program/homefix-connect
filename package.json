{
  "name": "homefix-connect",
  "version": "0.1.0",
  "private": true,
  "description": "Homefix Connect MVP — videollamada 1-a-1 con Vonage Video y SMS post-visita con Vonage Messages",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "globals": "^16.3.0",
    "typescript-eslint": "^8.42.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:generate": "pnpm --filter backend db:generate",
    "db:push": "pnpm --filter backend db:push",
    "db:seed": "pnpm --filter backend db:seed",
    "db:studio": "pnpm --filter backend db:studio",
    "db:reset": "docker compose down -v && docker compose up -d && pnpm db:push && pnpm db:seed"
  }
}
